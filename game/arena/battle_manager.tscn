[gd_scene format=3 uid="uid://b518ysonl8xuh"]

[sub_resource type="GDScript" id="GDScript_0mjbs"]
resource_name = "battle_manager"
script/source = "extends Node

@export var player_scene: PackedScene
@export var enemy_scene: PackedScene

@export var player_spawn: Vector2 = Vector2(320, 360)
@export var enemy_spawns: Array[Vector2] = [
	Vector2(780, 220),
	Vector2(840, 360),
	Vector2(780, 500),
]

## Точка появления врагов из очереди — за пределами экрана.
## Важно только X: Y принудительно берётся из последнего слота (enemy_spawns.back().y),
## чтобы новый враг въезжал строго по высоте последнего слота.
@export var offscreen_spawn_x: float = 950.0

@export var reflow_duration: float = 0.3
@export var death_fade_duration: float = 0.3

## Длительность осветления (fade-in) врага при появлении из очереди.
@export var spawn_fade_duration: float = 0.3

## Всего врагов за волну. Первые enemy_spawns.size() — на поле, остальные в очереди.
@export var total_enemies: int = 6

## Приоритеты отрисовки врагов.
## Лидер (первый в массиве) всегда выше остальных,
## а умирающий лидер — ещё выше, чтобы death-анимация не уходила за спины.
## Атакующий поднимается над всеми через CharacterBase.z_attack_priority
## (см. _apply_z_order — он пропускает атакующего).
@export var z_first_enemy: int = 10
@export var z_other_enemy: int = 0
@export var z_dying_first: int = 100

@onready var arena: Node2D = get_parent()

var player: Player
var enemies: Array[CharacterBase] = []
var _reflow_pending: bool = false
var _spawned_count: int = 0  # сколько уже заспавнено всего (на поле + выбывшие)

func _ready() -> void:
	# Родитель ещё занят настройкой детей — откладываем спавн на idle-тик.
	_spawn_all.call_deferred()

func _spawn_all() -> void:
	# Игрок
	player = player_scene.instantiate() as Player
	arena.add_child(player)
	player.global_position = player_spawn
	player.reset_idle_point()
	player.enemies = enemies
	player.retreat_started.connect(_on_attacker_retreat_started)

	# Первая партия врагов — до 3-х (по числу слотов), без осветления
	var initial := mini(enemy_spawns.size(), total_enemies)
	for i in initial:
		var e := _spawn_enemy_at(enemy_spawns[i], false)
		enemies.append(e)

	# Массив — ссылка, player.enemies и enemies всегда синхронны
	player.enemies = enemies

	# Лидер (индекс 0) — поверх остальных врагов.
	_apply_z_order()

func _spawn_enemy_at(pos: Vector2, fade_in: bool) -> CharacterBase:
	var e := enemy_scene.instantiate() as CharacterBase
	arena.add_child(e)
	e.global_position = pos
	e.reset_idle_point()
	e.died.connect(_on_enemy_died.bind(e))
	# После окончания атаки (или движения) врага — пересчитываем z.
	# Это нужно, потому что во время атаки зомби был поднят над всеми,
	# а за время атаки лидерство могло смениться.
	e.turn_finished.connect(_apply_z_order)
	_spawned_count += 1
	if fade_in:
		_start_fade_in(e)
	return e

## Плавно проявляет врага: alpha 0 → исходная alpha за spawn_fade_duration.
func _start_fade_in(e: CharacterBase) -> void:
	var final_alpha := e.modulate.a
	e.modulate.a = 0.0
	var tw := create_tween()
	tw.tween_property(e, \"modulate:a\", final_alpha, spawn_fade_duration)

## Точка появления из очереди: X за экраном, Y — строго как у последнего слота.
func _queue_spawn_point() -> Vector2:
	var last_slot := enemy_spawns[enemy_spawns.size() - 1]
	return Vector2(offscreen_spawn_x, last_slot.y)

func _has_queued_enemy() -> bool:
	return _spawned_count < total_enemies

## Расставляет z_index по массиву: лидер (индекс 0) — выше всех,
## остальные — на базовом уровне.
## Атакующий пропускается: у него z уже поднят до z_attack_priority,
## и мы не должны его перебивать во время reflow.
func _apply_z_order() -> void:
	for i in enemies.size():
		var e := enemies[i]
		if not is_instance_valid(e):
			continue
		if e.is_attacking():
			continue
		e.set_z_priority(z_first_enemy if i == 0 else z_other_enemy)

func _on_enemy_died(enemy: CharacterBase) -> void:
	var idx := enemies.find(enemy)
	if idx == -1:
		return

	# Если умирает лидер — поднимаем его над всеми, чтобы анимация смерти
	# (knockback/fade) не ушла за спины выживших и нового лидера.
	if idx == 0:
		enemy.set_z_priority(z_dying_first)

	enemies.remove_at(idx)

	# Есть враг в очереди — спавним за экраном (Y выровнен по последнему слоту)
	# с осветлением и ставим в КОНЕЦ массива. Reflow свапнет всех по слотам:
	#   выжившие сдвинутся влево, заполняя дырку,
	#   новичок приедет из-за экрана в последний слот (780, 500) по той же высоте.
	if _has_queued_enemy():
		var replacement := _spawn_enemy_at(_queue_spawn_point(), true)
		enemies.append(replacement)

	# Reflow нужен всегда: и когда очередь пуста (сжатие выживших),
	# и когда есть замена (свап новичка в последний слот + сдвиг выживших).
	if player and player.is_busy():
		_reflow_pending = true
	else:
		_reflow_enemies()

func _on_attacker_retreat_started() -> void:
	if _reflow_pending:
		_reflow_pending = false
		_reflow_enemies()

func _reflow_enemies() -> void:
	for i in enemies.size():
		var e := enemies[i]
		if not is_instance_valid(e):
			continue
		e.idle_point = enemy_spawns[i]
		e.move_to_idle_point(reflow_duration)

	# После сдвига лидер мог смениться — пересчитываем z-приоритеты.
	_apply_z_order()
"

[node name="BattleManager" type="Node" unique_id=429190078]
script = SubResource("GDScript_0mjbs")
