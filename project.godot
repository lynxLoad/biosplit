;   param=value ; assign values to parameters

config_version=5

[application]

config/name="biosplit_02"
run/main_scene="uid://m1v7fgeqvrli"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

DCKit="*uid://g1vgmlrh22q"
PauseManager="*uid://cd20rjrrctdth"
DcKitManager="*uid://bv4u7w6pxiwn1"
Console="*uid://ck00brbmqjkwj"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dc_kit/plugin.cfg")

[global_group]

pause_on_menu=""

